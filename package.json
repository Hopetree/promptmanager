{
  "name": "promptmanager",
  "version": "1.3.0",
  "private": true,
  "description": "轻量 Prompt 管理器：单进程自托管（Node + SQLite + React/antd）",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build",
    "typecheck:web": "tsc -p web/tsconfig.json",
    "start": "node dist/server/index.js",
    "migrate": "npm run build:server && node bin/pm.mjs migrate",
    "test": "npm run build && npm run typecheck:tests && node --test \"tests/**/*.test.ts\"",
    "typecheck:tests": "npm run build:server && tsc -p tsconfig.tests.json"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.4",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@node-rs/argon2": "2.2.1",
    "antd": "6.6.4",
    "better-sqlite3": "13.0.3",
    "diff": "9.0.0",
    "dompurify": "3.4.15",
    "fastify": "5.12.5",
    "highlight.js": "11.12.0",
    "jsdom": "30.1.0",
    "kysely": "0.29.6",
    "marked": "18.0.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
