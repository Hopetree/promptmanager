# promptmanager 环境变量模板（systemd EnvironmentFile 用）
#
# 部署时（由 host_manger 执行）：
#   install -d -m 755 /etc/promptmanager
#   install -m 600 deploy/promptmanager.env.example /etc/promptmanager/promptmanager.env
#   systemctl restart promptmanager
#
# ⚠️ 口令/密钥类变量的值必须留空：本项目管理员口令用 CLI 设置，不进环境文件、不进 git。
#    见 deploy/README.md 的"设置口令"步骤。

# ---- 监听（STANDARDS §3.2：必须 0.0.0.0，内网可达；端口只从台账 8765–8770 分配）----
HOST=0.0.0.0
# 默认端口 8767（与 README.md / PROGRESS.md 三处一致，AC-19）；改端口须同步改两处文档与台账
PORT=8767

# ---- 数据目录（SQLite 单文件 pm.db + media/）----
# 与 unit 里的 StateDirectory=promptmanager 对应（systemd 会创建 /var/lib/promptmanager 并 chown）
# 若改用其他路径，必须同时改 unit 的 ReadWritePaths 并自行 chown 给服务账号
DATA_DIR=/var/lib/promptmanager

# ---- 对外可用面（阶段 6：Token/CORS/部署形态）----
# CORS 白名单：逗号分隔的**精确 origin**（如 https://prompt.home.local）；留空 = 默认关闭（同源）。
# 禁止写 "*"（服务启动会直接报配置错误）。
CORS_ORIGINS=

# 只有在**确有反向代理**时才设为 1：开启后来源 IP 取 X-Forwarded-For（用于登录限流与日志）。
# 内网直连（浏览器/CLI 直接连 8767）时保持留空，否则伪造的 X-Forwarded-For 可以让登录限流失效。
TRUST_PROXY=

# 公网经 HTTPS 反代访问时填公开地址（形如 https://prompt.example.com，不带路径）：
# 设置后会话 cookie 会追加 Secure。内网 HTTP 直连时**留空**，否则浏览器不会回传 cookie、登录不上。
PUBLIC_ORIGIN=

# ---- 会话与登录限流 ----
SESSION_TTL_HOURS=720
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=60

# ---- 口令/密钥类：值必须留空 ----
# 真实口令（哈希后存库）由下列命令交互设置，绝不写入本文件：
#   printf '%s\n' '<你的口令>' | node bin/pm.mjs user set-password --username admin
ADMIN_PASSWORD=
SESSION_SECRET=
